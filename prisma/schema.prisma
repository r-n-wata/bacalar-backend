generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LocaleCode {
  en
  es
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FeatureType {
  EVENTS
  RESTAURANTS
  TOURS
}

enum EventCategory {
  music
  wellness
  food
}

enum RestaurantMoment {
  breakfast
  lunch
  dinner
}

enum TourCategory {
  premium
  group
  adventure
}

enum EventSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RestaurantSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TourSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionImageSource {
  UPLOADED
  EXTERNAL_URL
}

enum SpotlightKey {
  EVENTS
  RESTAURANTS
  TOURS
}

enum HomeSectionKind {
  FEATURED_EXPERIENCES
  DINING_MOMENTS
  WEEKLY_HAPPENINGS
}

model Locale {
  id                          Int                         @id @default(autoincrement())
  code                        LocaleCode                  @unique
  name                        String
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  eventTranslations           EventTranslation[]
  featurePageTranslations     FeaturePageTranslation[]
  homePageTranslations        HomePageTranslation[]
  homeSectionCardTranslations HomeSectionCardTranslation[]
  homeSectionTranslations     HomeSectionTranslation[]
  homeSpotlightTranslations   HomeSpotlightEntryTranslation[]
  restaurantTranslations      RestaurantTranslation[]
  tourTranslations            TourTranslation[]
}

model FeaturePage {
  id           String                   @id @default(cuid())
  feature      FeatureType              @unique
  status       ContentStatus            @default(PUBLISHED)
  slug         String                   @unique
  sortOrder    Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  publishedAt  DateTime?
  createdBy    String?
  updatedBy    String?
  translations FeaturePageTranslation[]
}

model FeaturePageTranslation {
  id            String      @id @default(cuid())
  featurePageId String
  localeId      Int
  eyebrow       String
  title         String
  description   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  featurePage   FeaturePage @relation(fields: [featurePageId], references: [id], onDelete: Cascade)
  locale        Locale      @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([featurePageId, localeId])
}

model Event {
  id                  String             @id @default(cuid())
  slug                String             @unique
  status              ContentStatus      @default(PUBLISHED)
  category            EventCategory
  sortOrder           Int                @default(0)
  isFeatured          Boolean            @default(false)
  featuredOrder       Int?
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  publishedAt         DateTime?
  createdBy           String?
  updatedBy           String?
  approvedSubmissions EventSubmission[]
  translations        EventTranslation[]
}

model EventTranslation {
  id           String   @id @default(cuid())
  eventId      String
  localeId     Int
  title        String
  dateLabel    String
  venue        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locale       Locale   @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([eventId, localeId])
}

model EventSubmission {
  id              String                @id @default(cuid())
  status          EventSubmissionStatus @default(PENDING)
  title           String
  startsAt        DateTime
  location        String
  category        EventCategory
  description     String
  contactName     String
  contactMethod   String
  instagram       String?
  whatsapp        String?
  submittedLocale LocaleCode
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?
  approvedEventId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  approvedEvent   Event?                @relation(fields: [approvedEventId], references: [id], onDelete: SetNull)
  images          EventSubmissionImage[]
}

model EventSubmissionImage {
  id               String                @id @default(cuid())
  submissionId     String
  source           SubmissionImageSource
  url              String
  objectKey        String?
  mimeType         String?
  originalFilename String?
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  submission       EventSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model RestaurantSubmission {
  id              String                     @id @default(cuid())
  status          RestaurantSubmissionStatus @default(PENDING)
  name            String
  cuisine         String
  moment          String
  priceBand       String
  description     String
  contactName     String
  contactMethod   String
  instagram       String?
  whatsapp        String?
  submittedLocale LocaleCode
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?
  approvedRestaurantId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  approvedRestaurant Restaurant?             @relation(fields: [approvedRestaurantId], references: [id], onDelete: SetNull)
  images          RestaurantSubmissionImage[]
}

model TourSubmission {
  id              String               @id @default(cuid())
  status          TourSubmissionStatus @default(PENDING)
  name            String
  category        TourCategory
  durationHours   Int
  priceFrom       Int
  description     String
  contactName     String
  contactMethod   String
  instagram       String?
  whatsapp        String?
  submittedLocale LocaleCode
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?
  approvedTourId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  approvedTour    Tour?                @relation(fields: [approvedTourId], references: [id], onDelete: SetNull)
  images          TourSubmissionImage[]
}

model TourSubmissionImage {
  id               String         @id @default(cuid())
  submissionId     String
  source           SubmissionImageSource
  url              String
  objectKey        String?
  mimeType         String?
  originalFilename String?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  submission       TourSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model RestaurantSubmissionImage {
  id               String               @id @default(cuid())
  submissionId     String
  source           SubmissionImageSource
  url              String
  objectKey        String?
  mimeType         String?
  originalFilename String?
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  submission       RestaurantSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  status        ContentStatus           @default(PUBLISHED)
  priceBand     String
  moments       RestaurantMoment[]
  sortOrder     Int                     @default(0)
  isFeatured    Boolean                 @default(false)
  featuredOrder Int?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  publishedAt   DateTime?
  createdBy     String?
  updatedBy     String?
  approvedSubmissions RestaurantSubmission[]
  translations  RestaurantTranslation[]
}

model RestaurantTranslation {
  id            String     @id @default(cuid())
  restaurantId  String
  localeId      Int
  name          String
  cuisine       String
  vibe          String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  locale        Locale     @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, localeId])
}

model Tour {
  id            String            @id @default(cuid())
  slug          String            @unique
  status        ContentStatus     @default(PUBLISHED)
  category      TourCategory
  durationHours Int
  priceFrom     Int
  sortOrder     Int               @default(0)
  isFeatured    Boolean           @default(false)
  featuredOrder Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime?
  createdBy     String?
  updatedBy     String?
  approvedSubmissions TourSubmission[]
  translations  TourTranslation[]
}

model AdminAccount {
  id             String   @id @default(cuid())
  email          String   @unique
  supabaseUserId String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TourTranslation {
  id           String   @id @default(cuid())
  tourId       String
  localeId     Int
  name         String
  category     String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  locale       Locale   @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([tourId, localeId])
}

model HomePage {
  id               String               @id @default(cuid())
  slug             String               @unique
  status           ContentStatus        @default(PUBLISHED)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  publishedAt      DateTime?
  createdBy        String?
  updatedBy        String?
  translations     HomePageTranslation[]
  spotlightEntries HomeSpotlightEntry[]
  sections         HomeSection[]
}

model HomePageTranslation {
  id                 String   @id @default(cuid())
  homePageId         String
  localeId           Int
  heroEyebrow        String
  heroTitle          String
  heroDescription    String
  calloutEyebrow     String
  calloutTitle       String
  calloutDescription String
  calloutItems       String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  homePage           HomePage @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  locale             Locale   @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([homePageId, localeId])
}

model HomeSpotlightEntry {
  id           String                       @id @default(cuid())
  homePageId   String
  key          SpotlightKey
  route        String
  sortOrder    Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  homePage     HomePage                     @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  translations HomeSpotlightEntryTranslation[]

  @@unique([homePageId, key])
}

model HomeSpotlightEntryTranslation {
  id          String                        @id @default(cuid())
  entryId     String
  localeId    Int
  actionLabel String
  title       String
  description String
  ctaLabel    String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  entry       HomeSpotlightEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale      Locale                        @relation(fields: [localeId], references: [id], onDelete: Restrict)
  metrics     HomeSpotlightMetric[]

  @@unique([entryId, localeId])
}

model HomeSpotlightMetric {
  id            String                        @id @default(cuid())
  translationId String
  sortOrder     Int                           @default(0)
  label         String
  value         String
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  translation   HomeSpotlightEntryTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
}

model HomeSection {
  id           String                   @id @default(cuid())
  homePageId   String
  kind         HomeSectionKind
  sortOrder    Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  homePage     HomePage                 @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  translations HomeSectionTranslation[]
  cards        HomeSectionCard[]

  @@unique([homePageId, kind])
}

model HomeSectionTranslation {
  id          String      @id @default(cuid())
  sectionId   String
  localeId    Int
  eyebrow     String
  title       String
  description String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  section     HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  locale      Locale      @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([sectionId, localeId])
}

model HomeSectionCard {
  id           String                     @id @default(cuid())
  sectionId    String
  route        String
  sortOrder    Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  section      HomeSection                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  translations HomeSectionCardTranslation[]
}

model HomeSectionCardTranslation {
  id          String          @id @default(cuid())
  cardId      String
  localeId    Int
  label       String?
  title       String
  description String
  meta        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  card        HomeSectionCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  locale      Locale          @relation(fields: [localeId], references: [id], onDelete: Restrict)

  @@unique([cardId, localeId])
}
